# Lab config for the Ubuntu 24.04 guest (strict snap confinement needs Ubuntu's AppArmor kernel).
# Create with: LAB_ENV=lab.snap.env scripts/lab.sh up snap ; other commands use lab.env.
. "$(dirname "${BASH_SOURCE[0]}")/lab.env"
LAB_BASE_VOL=noble-base.qcow2
LAB_OS_VARIANT=ubuntu24.04
