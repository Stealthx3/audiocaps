# SPDX-License-Identifier: LGPL-2.1-or-later
# VM Lab Standard v1.2 config (see docs/LAB.md). No secrets.
LAB_PROJECT=audiocaps
LAB_URI=qemu:///system
LAB_KIND=vm
LAB_NET=default
LAB_POOL=default
LAB_BASE_VOL=lab-base-debian13.qcow2
LAB_OS_VARIANT=debian13
LAB_VCPUS=4
LAB_RAM_MB=6144
LAB_DISK_GB=30
LAB_USER=lab
LAB_SSH_KEY="$HOME/.ssh/id_ed25519.pub"
LAB_DEST=/home/lab/src
LAB_HOST_RESERVE_MB=4096
LAB_GRAPHICS=spice,listen=none
LAB_AUTO_VIEW=1
LAB_LXC_ROOTFS=
